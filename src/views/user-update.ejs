<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <!-- bootstrap 5-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>

    <div class="container">
        <div class="row">
            <div class="edit-user-infor-container">
                <form method="post" action="/users/update-user">

                    <div class="pt-3 ">
                        <h3>update user</h3>
                    </div>
                    <input type="hidden" name="id" value="<%=userData.id%>">
                    <div class="mb-3 mt-3 col-6">
                        <label for="email" class="form-label">Email address</label>
                        <input type="email" value="<%=userData.email%>" class="form-control" id="email" name="email"
                            required>
                    </div>
                    <div class="col-6"></div>
                    <div class="col-6"></div>
                    <div class="pb-3 col-6">
                        <label for="username" class="form-label">Username</label>
                        <input type="text" value="<%=userData.username%>" class="form-control" id="username"
                            name="username" required>
                    </div>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">Update</button>

                </form>

            </div>

        </div>
    </div>
</body>

</html>